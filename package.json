{
  "name": "local-kody",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A local, single-user take on kentcdodds/kody: two MCP tools (search, execute) over a Deno sandbox.",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "node src/server.ts",
    "daemon": "node src/daemon.ts",
    "daemon:install": "node src/launchd.ts install",
    "daemon:uninstall": "node src/launchd.ts uninstall",
    "daemon:logs": "node src/launchd.ts logs",
    "secret": "node src/cli.ts",
    "integration": "node src/integration-cli.ts",
    "test": "node test/scheduler.ts && node test/e2e.ts",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "croner": "^10.0.1",
    "deno": "^2.9.6",
    "es-module-lexer": "^3.0.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "prettier": "^3.9.8",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "deno@2.9.6": true
  }
}
