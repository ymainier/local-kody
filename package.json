{
  "name": "local-kody",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A local, single-user take on kentcdodds/kody: two MCP tools (search, execute) over a Deno sandbox.",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "node src/server.ts",
    "secret": "node src/cli.ts",
    "test": "node test/e2e.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "deno": "^2.9.6",
    "es-module-lexer": "^3.0.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "deno@2.9.6": true
  }
}
